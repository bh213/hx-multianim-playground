version: 0.5

// Particles Demo — Basics
// Emission modes, lifetime, speed, size, fading

relativeLayouts {
    #positions list {
        point: 160, 380
        point: 400, 180
        point: 680, 380
        point: 940, 380
    }
}

#fire particles {
    count: 80
    emit: cone(10, 5, 270, 25)
    tiles: file("circle_soft.png")
    loop: true
    maxLife: 1.8
    speed: 60
    speedRandom: 0.3
    gravity: 40
    gravityAngle: 270
    size: 0.6
    sizeRandom: 0.3
    fadeOut: 0.7
    fadeIn: 0.1
    0.0: colorCurve: linear, #FF4400, #FFAA00
    0.4: colorCurve: linear, #FFAA00, #FFFF88
    blendMode: add
}

#rain particles {
    count: 150
    emit: box(150, 5, 95, 5)
    tiles: file("spark.png")
    loop: true
    maxLife: 1.2
    lifeRandom: 0.3
    speed: 300
    speedRandom: 0.15
    size: 0.3
    sizeRandom: 0.1
    fadeIn: 0.05
    fadeOut: 0.9
    0.0: colorCurve: linear, #AACCFF, #6688CC
    rotateAuto: true
}

#sparkles particles {
    count: 50
    emit: circle(60, 30, 0, 0)
    tiles: file("star.png")
    loop: true
    maxLife: 2.0
    speed: 15
    speedRandom: 0.5
    size: 0.4
    sizeRandom: 0.3
    fadeIn: 0.2
    fadeOut: 0.6
    0.0: colorCurve: linear, #FFFFFF, #88DDFF
    0.5: colorCurve: linear, #88DDFF, #4488FF
    blendMode: add
    rotationSpeed: 45
    rotationSpeedRandom: 0.5
}

#explosion particles {
    count: 60
    emit: point(0, 15)
    tiles: file("circle_hard.png") file("flare.png")
    loop: true
    maxLife: 0.8
    lifeRandom: 0.3
    speed: 200
    speedRandom: 0.5
    gravity: 150
    gravityAngle: 90
    size: 0.5
    sizeRandom: 0.4
    fadeIn: 0.0
    fadeOut: 0.4
    0.0: colorCurve: linear, #FFFF88, #FF4400
    0.5: colorCurve: linear, #FF4400, #882200
    blendMode: add
    emitSync: 0.9
}

#basicsUI programmable() {
    text(m6x11, "Fire", #FF6622, center, 120): 120, 20
    text(m3x6, "cone emission", #888888, center, 120): 120, 36
    text(m6x11, "Rain", #88BBFF, center, 120): 380, 20
    text(m3x6, "box emission", #888888, center, 120): 380, 36
    text(m6x11, "Sparkles", #88DDFF, center, 120): 640, 20
    text(m3x6, "circle emission", #888888, center, 120): 640, 36
    text(m6x11, "Explosion", #FF8844, center, 120): 900, 20
    text(m3x6, "point emission", #888888, center, 120): 900, 36
}
