version: 1.0

// Rich Text AutoFit Demo
// Interactive autoFit mode explorer: choose bounds, fill mode, fonts, and text.

#richTextAutofitDemo programmable() {
    pos: 40, 70

    text(exo2_16, "Rich Text AutoFit", #7fdbda): 0, 0
    bitmap(generated(color(700, 1, #7fdbda33))): 0, 22
    text(exo2_light_14, "Explore autoFit modes interactively. Change bounds, mode, fonts, and text to see how autoFit selects the best font.", #aaaaaa, left, 700): 0, 30

    // ─── Controls Row 1: Mode (radio) ───────────────────
    text(m6x11, "Mode:", #888888): 0, 65
    placeholder(generated(cross(480, 24, #FF0000)), builderParameter("modeRadio")) {
        pos: 45, 61
        settings{radioButtonBuildName=>radio}
    }

    // ─── Controls Row 2: Bounds (Width / Height) ────────
    text(m6x11, "Width:", #888888): 0, 95
    placeholder(generated(cross(200, 20, #FF0000)), builderParameter("widthSlider")) {
        pos: 50, 92
        settings{size:int=>200, min:int=>30, max:int=>600, step:int=>10}
    }
    #widthValue(updatable) text(m6x11, "200", #cccccc): 262, 95

    text(m6x11, "Height:", #888888): 300, 95
    placeholder(generated(cross(200, 20, #FF0000)), builderParameter("heightSlider")) {
        pos: 350, 92
        settings{size:int=>200, min:int=>8, max:int=>200, step:int=>2}
    }
    #heightValue(updatable) text(m6x11, "40", #cccccc): 562, 95

    // ─── Controls Row 3: Fonts ──────────────────────────
    text(m6x11, "Fonts:", #888888): 0, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkPixellari")): 45, 122
    text(m6x11, "pixellari", #aaaaaa): 67, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkDd")): 140, 122
    text(m6x11, "dd", #aaaaaa): 162, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkM6x11")): 195, 122
    text(m6x11, "m6x11", #aaaaaa): 217, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkM5x7")): 270, 122
    text(m6x11, "m5x7", #aaaaaa): 292, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkM3x6")): 335, 122
    text(m6x11, "m3x6", #aaaaaa): 357, 125

    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkF7x5")): 400, 122
    text(m6x11, "f7x5", #aaaaaa): 422, 125

    // Rich text toggle
    placeholder(generated(cross(20, 20, #FF0000)), builderParameter("chkRichText")): 480, 122
    text(m6x11, "Rich", #888888): 502, 125

    // ─── Controls Row 4: Text Input (multiline) ─────────
    text(m6x11, "Text:", #888888): 0, 154
    placeholder(generated(cross(500, 60, #FF0000)), builderParameter("textInput")) {
        pos: 35, 150
        settings{buildName=>textInput, font=>dd, placeholder=>"Type text here...", multiline=>true, inputWidth=>450, width=>500}
    }

    // ─── Display Area ───────────────────────────────────
    #statusText(updatable) text(m6x11, "Mode: Width | Bounds: 200 | Fonts: pixellari, dd, m6x11, m5x7, m3x6, f7x5 | Selected: dd", #666666): 0, 225
}
