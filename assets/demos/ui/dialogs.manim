    text(exo2_black_20, "Warning!", #ff4444, center, 460): 20, 20
    bitmap(generated(color(460, 1, #ff444433))): 20, 50
    #dialogText(updatable) text(exo2_light_14, $dialogText, #ffcccc, center, 400): 50, 80

