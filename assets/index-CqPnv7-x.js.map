export default "sheet: crew2\nallowedExtraPoints: [\"line_TR\", \"line_BR\", \"line_TL\", \"line_BL\"]\nstates: direction(l, r)\ncenter: 32,48\n\nanimation idle_0 {\n    fps: 4\n    loop: yes\n    playlist {\n        sheet: \"shield_${direction}_layer0\"\n    }\n    extrapoints {\n        line_TR: 8, -16\n        line_TL: -8, -16\n        line_BR: 7, -1\n        line_BL: -7, -1\n    }\n}\n\nanimation impact {\n    fps: 10\n    loop: yes\n    playlist {\n        sheet: \"shield_${direction}_layer2_impact fast\"\n    }\n}\n\nanimation idle_1 {\n    fps: 10\n    loop: yes\n    playlist {\n        sheet: \"shield_${direction}_layer1\"\n    }\n}\n"