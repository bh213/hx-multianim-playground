    // --- Row 4: Hand path dropdown --- Y=130
    text(m5x7, "Hand path:", #667799): 858, 140
    placeholder(generated(cross(120, 30, white)), builderParameter("handPathDropdown")) {
        pos: 940, 130
    }

    // --- Row 5: Draw easing + duration --- Y=164
    text(m5x7, "Draw:", #778899): 858, 174
    placeholder(generated(cross(120, 30, white)), builderParameter("drawDropdown")) {
        pos: 910, 164
    }
    text(m5x7, "dur:", #555555): 1040, 174
    placeholder(generated(cross(100, 12, white)), builderParameter("drawSlider")) {
        pos: 1072, 173
    }
    #drawDurLabel text(m5x7, "1.0", #888888): 1180, 174

    // --- Row 6: Discard easing + duration --- Y=198
    text(m5x7, "Discard:", #778899): 858, 208
