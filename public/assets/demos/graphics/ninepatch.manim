version: 1.0

paths {
    #straightLine path {
        lineTo(100, 0)
    }
}

#returnAnim animatedPath {
    path: straightLine
    type: time
    duration: 0.5
    easing: easeoutelastic
}

#snapAnim animatedPath {
    path: straightLine
    type: time
    duration: 0.7
    easing: easeoutcubic
}

#ninepatchShowcase programmable() {
  // Section 1: Same ninepatch at different sizes
  text(exo2_16, "Window_3x3_idle at 5 different sizes:", #cccccc): 0, 0

  ninepatch("ui", "Window_3x3_idle", 100, 60): 0, 30
  text(m6x11, "100 x 60", #888888, center, 100): 0, 96

  ninepatch("ui", "Window_3x3_idle", 200, 80): 120, 30
  text(m6x11, "200 x 80", #888888, center, 200): 120, 116

  ninepatch("ui", "Window_3x3_idle", 300, 120): 340, 30
  text(m6x11, "300 x 120", #888888, center, 300): 340, 156

  ninepatch("ui", "Window_3x3_idle", 150, 200): 660, 30
  text(m6x11, "150 x 200", #888888, center, 150): 660, 236

  ninepatch("ui", "Window_3x3_idle", 400, 40): 0, 180
  text(m6x11, "400 x 40", #888888, center, 400): 0, 226

  // Section 2: Button ninepatches
  text(exo2_16, "Button ninepatches at different sizes:", #cccccc): 0, 270

  ninepatch("ui", "button-idle", 100, 30): 0, 300
  text(m6x11, "idle 100x30", #888888): 0, 336

  ninepatch("ui", "button-hover", 150, 30): 120, 300
  text(m6x11, "hover 150x30", #888888): 120, 336

  ninepatch("ui", "button-pressed", 200, 30): 290, 300
  text(m6x11, "pressed 200x30", #888888): 290, 336

  ninepatch("ui", "button-idle", 300, 50): 0, 370
  text(m6x11, "idle 300x50", #888888): 0, 426

  ninepatch("ui", "button-hover", 80, 80): 320, 370
  text(m6x11, "hover 80x80", #888888): 320, 456

  // Section 3: Scaled ninepatches
  text(exo2_16, "Scaled ninepatches:", #cccccc): 0, 490

  @scale(2) ninepatch("ui", "Window_3x3_idle", 80, 40): 0, 520
  text(m6x11, "scale 2", #888888): 0, 610

  @scale(3) ninepatch("ui", "Window_3x3_idle", 60, 30): 200, 520
  text(m6x11, "scale 3", #888888): 200, 620

  // Section 4: tiled beside stretched — the same cell, its middle and edges repeated or stretched
  text(exo2_16, "Tiled (the default) beside stretched:", #cccccc): 0, 660
  @scale(3) ninepatch("ui", "button-hover", 90, 40): 0, 690
  text(m6x11, "button-hover, tile", #888888): 0, 816
  @scale(3) ninepatch("ui", "button-hover", 90, 40, stretch): 300, 690
  text(m6x11, "button-hover, stretch", #888888): 300, 816
  @scale(3) ninepatch("ui", "Droppanel_3x3_idle", 90, 40, tile): 600, 690
  text(m6x11, "Droppanel, tile", #888888): 600, 816

  // Section 5: the sheet and the cell as parameters — one programmable, four styles
  text(exo2_16, "Sheet and cell from a parameter (\"button-\" + $style):", #cccccc): 0, 850
  staticRef($styledButton, style => "idle"): 0, 880
  staticRef($styledButton, style => "hover"): 140, 880
  staticRef($styledButton, style => "pressed"): 280, 880
  staticRef($styledButton, style => "disabled"): 420, 880

  // Section 6: the frames of an indexed name — one each, and all of them played in a loop
  text(exo2_16, "Frames of an indexed name (index: 0..3) and the loop (fps: 6):", #cccccc): 0, 940
  @scale(2) ninepatch("ui", "Animated button test - Altcolor/Button_Warning_3x3_idle", 50, 30, index: 0): 0, 970
  @scale(2) ninepatch("ui", "Animated button test - Altcolor/Button_Warning_3x3_idle", 50, 30, index: 1): 120, 970
  @scale(2) ninepatch("ui", "Animated button test - Altcolor/Button_Warning_3x3_idle", 50, 30, index: 2): 240, 970
  @scale(2) ninepatch("ui", "Animated button test - Altcolor/Button_Warning_3x3_idle", 50, 30, index: 3): 360, 970
  @scale(2) ninepatch("ui", "Animated button test - Altcolor/Button_Warning_3x3_idle", 80, 30, fps: 6): 520, 970
  text(m6x11, "fps: 6", #888888): 520, 1036
}

#styledButton programmable(style:string="idle") {
  ninepatch("ui", "button-" + $style, 120, 40): 0, 0
  text(m6x11, $style, #ffffff, center, 120): 0, 14
}

#resizablePanel programmable(width:60..510=210, height:60..210=150) {
    ninepatch("ui", "Window_3x3_idle", $width, $height): 0, 0
    #sizeText(updatable) text(m6x11, "210 x 150", #ffffff, left, 200): 10, 10
}
