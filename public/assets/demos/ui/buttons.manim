version: 0.5

// Buttons Demo
// Shows multiple button styles, click counter, and disable toggle.

#buttonsDemo programmable() {
    pos: 50, 80

    // Section: Standard Buttons
    text(exo2_16, "Standard Buttons", #7fdbda): 0, 0
    bitmap(generated(color(400, 1, #7fdbda33))): 0, 22

    // Button placeholders arranged horizontally
    placeholder(generated(cross(200, 30)), builderParameter("button1")) {
        pos: 0, 40
    }
    placeholder(generated(cross(200, 30)), builderParameter("button2")) {
        pos: 220, 40
        settings{text=>"Action"}
    }
    placeholder(generated(cross(200, 30)), builderParameter("button3")) {
        pos: 440, 40
        settings{text=>"Submit"}
    }

    // Click counter display
    text(exo2_16, "Click Counter", #7fdbda): 0, 100
    bitmap(generated(color(400, 1, #7fdbda33))): 0, 122
    ninepatch("ui", "Window_3x3_idle", 300, 40): 0, 140
    #counterText(updatable) text(exo2_20, "Clicks: 0", #ffffff, left, 280): 15, 148

    // Disable toggle section
    text(exo2_16, "Disable Toggle", #7fdbda): 0, 210
    bitmap(generated(color(400, 1, #7fdbda33))): 0, 232
    placeholder(generated(cross(200, 20)), builderParameter("disableCheckbox")) {
        pos: 0, 250
        settings{buildName=>checkbox}
    }
    text(exo2_light_14, "Toggle to disable all buttons", #aaaaaa): 30, 252

    // Disabled button for reference
    text(exo2_16, "Button States", #7fdbda): 0, 310
    bitmap(generated(color(400, 1, #7fdbda33))): 0, 332
    placeholder(generated(cross(200, 30)), builderParameter("button4")) {
        pos: 0, 350
        settings{text=>"Normal"}
    }
    placeholder(generated(cross(200, 30)), builderParameter("button5")) {
        pos: 220, 350
        settings{text=>"Disabled"}
    }
}
